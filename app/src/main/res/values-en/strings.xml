    <!-- Tier 2 Contextual Page Tours -->
    <string name="tour_settings_drive_title">Cloud Sync &amp; Google Drive</string>
    <string name="tour_settings_drive_desc">Connect your Google Account to back up business records into private Google Drive storage (drive.appdata) securely. There is no third-party server — backups live entirely in your own Google Drive, in a hidden folder that only this app can access.</string>
    <string name="tour_settings_security_title">AES-256-GCM Encryption &amp; Reset</string>
    <string name="tour_settings_security_desc">All backups are encrypted with your custom passphrase using AES-256-GCM. Without this passphrase, backups cannot be opened — not even by the app developer. Keep it somewhere safe. The local database can also be reset at any time.</string>

    <string name="tour_scope_business_title">Add &amp; Manage Businesses</string>
    <string name="tour_scope_business_desc">Create separate business ventures — for example \"Retail Shop\", \"Coffee Shop\", or \"Auto Repair Service\". Each venture has its own categories, units, and projects that never mix.</string>
    <string name="tour_scope_field_title">Projects &amp; Accounting Periods</string>
    <string name="tour_scope_field_desc">Register specific projects, branches, or accounting periods with start and end dates. Feasibility reports (BEP, HPP) are calculated per project or period.</string>

    <string name="tour_import_picker_title">Select Excel Workbook (.xlsx)</string>
    <string name="tour_import_picker_desc">Pick your business records Excel file. Column layouts and sheets are analyzed and matched intelligently. Unrecognised columns can be mapped manually before the final import.</string>
    <string name="tour_import_target_title">Select Target Ledger</string>
    <string name="tour_import_target_desc">Choose whether imported records land in the Plan (Projection) or Actual (Realized Cash) book. Import into Plan to transfer an existing budget; import into Actual to transfer real cash records from a previous season.</string>

    <string name="tour_reports_cashflow_title">Operating Cash Flow</string>
    <string name="tour_reports_cashflow_desc">Cash flow shows money that actually moved — not promises or receivables. Operating tracks core business activity; Investing tracks asset purchases (machinery, equipment); Financing tracks own capital and loans. If operating cash is negative but profit is positive, it means many sales have not been paid yet.</string>
    <string name="tour_data_export_title">Export &amp; Backup</string>
    <string name="tour_data_export_desc">Export records to an Excel workbook (.xlsx) or a PDF report for print archiving. AES-256-GCM encrypted local backups can be saved to phone storage, and cloud backups to your private Google Drive. Back up regularly — especially before switching phones or at the end of an accounting period.</string>
    <string name="tour_settings_display_title">Display &amp; Language</string>
    <string name="tour_settings_display_desc">Switch between Light, Dark, or System theme. Choose Indonesian or English. Adjust animation speed: Full for smooth transitions, Reduced for slower devices. Haptic feedback and tap sounds can also be toggled here.</string>

    <string name="about_desc">Mankeu is an offline-first MSME financial management and bookkeeping app. It helps business owners, MSME managers, and entrepreneurs record transactions, build projected budgets, calculate break-even (BEP), COGS (HPP), working capital, and feasibility ratios accurately without an internet connection.</string>
    <string name="about_version">Version %s</string>

