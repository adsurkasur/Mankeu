    <string name="settings_tour_reset_help">Tandai semua panduan sebagai belum dilihat, sehingga tiap halaman menjelaskan dirinya lagi saat dibuka.</string>
    <string name="msg_tours_reset">Semua panduan disetel ulang.</string>
