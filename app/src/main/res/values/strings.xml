    <!-- Tur panduan dan tentang aplikasi -->
    <string name="tour_title_scope_business">Kelola Usaha dan Proyek</string>
    <string name="tour_desc_scope_business">Pilih dan kelola berbagai unit usaha dan proyek aktif Anda. Data setiap usaha terisolasi total — transaksi, laporan, dan cadangan masing-masing independen. Menghapus satu usaha tidak memengaruhi usaha lain.</string>
    <string name="tour_title_scope_book">Proyeksi vs Realisasi</string>
    <string name="tour_desc_scope_book">Buku Proyeksi (Rencana/RAB) dan Realisasi (Kas Nyata) terisolasi penuh. Isi Proyeksi sebagai simulasi anggaran dan target usaha, catat Realisasi selama periode usaha berjalan, lalu bandingkan keduanya di menu Laporan → tab Perbandingan untuk menilai akurasi perencanaan.</string>
    <string name="tour_title_hero_summary">Ringkasan Kas &amp; Kesehatan Usaha</string>
    <string name="tour_desc_hero_summary">Pantau saldo kas operasional, laba bersih berjalan, arus kas masuk/keluar, serta piutang dan utang secara instan. Jika saldo tampak negatif padahal di tangan masih ada uang, kemungkinan modal awal belum dicatat — masukkan \"Modal Sendiri\" di menu Catatan agar saldo sesuai kenyataan.</string>
    <string name="tour_title_nav_entry">Menu Catatan Transaksi</string>
    <string name="tour_desc_nav_entry">Catat mutasi kas masuk/keluar, pembelian tempo, dan penjualan produk/jasa, serta pantau riwayat pembukuan lengkap pada tab Daftar Catatan.</string>
    <string name="tour_title_nav_reports">Menu Laporan &amp; Analisis Kelayakan</string>
    <string name="tour_desc_nav_reports">Akses laporan laba rugi, arus kas, dan indikator kelayakan finansial otomatis: BEP (Titik Impas), HPP, B/C Ratio, serta ekspor PDF &amp; Excel.</string>
    <string name="tour_title_nav_more">Menu Berkas &amp; Data</string>
    <string name="tour_desc_nav_more">Impor/ekspor catatan Excel (.xlsx), lakukan pencadangan terenkripsi AES-256-GCM ke Google Drive, dan kelola pengaturan akun.</string>
    <string name="tour_title_scope">Usaha, Proyek, dan Mode</string>
    <string name="tour_desc_scope">Pilih usaha dan proyek yang aktif, serta beralih antara mode Proyeksi (Rencana/Simulasi) dan Realisasi (Catatan Nyata).</string>
    <string name="tour_title_summary">Ringkasan Kas dan Biaya</string>
    <string name="tour_desc_summary">Pantau saldo kas operasional, laba/rugi, dan komposisi pengeluaran usaha secara real-time.</string>
    <string name="tour_title_nav">Navigasi Fitur Utama</string>
    <string name="tour_desc_nav">Gunakan menu bawah untuk mencatat transaksi harian, menyusun rencana anggaran (RAB), dan melihat analisis kelayakan usaha (BEP dan B/C Ratio).</string>
    <string name="tour_title_cost_chart">Komposisi Biaya</string>
    <string name="tour_desc_cost_chart">Semua pengeluaran dikelompokkan otomatis berdasarkan kategori akun usaha Anda (seperti Gaji &amp; Upah, Belanja Stok &amp; Bahan, Sewa Tempat, Operasional, dll.). Pantau pos pengeluaran terbesar agar efisiensi biaya dapat dioptimalkan.</string>
    <string name="tour_entry_tabs_title">Buat Catatan atau Lihat Riwayat</string>
    <string name="tour_entry_tabs_desc">Tab kiri untuk mencatat transaksi baru, tab kanan untuk melihat semua catatan yang sudah masuk beserta jumlahnya. Angka di tab kanan adalah banyaknya catatan pada proyek dan buku yang sedang aktif.</string>
    <string name="tour_entry_kinds_title">Pilih Jenis Transaksi</string>
    <string name="tour_entry_kinds_desc">Uang masuk dan Uang keluar untuk transaksi tunai sehari-hari. Ketuk \"Jenis lain\" untuk Modal Sendiri, Pinjaman, pembelian alat, serta penjualan atau pembelian tempo yang menimbulkan piutang dan utang. Setiap jenis otomatis menghasilkan jurnal yang tepat: Kas Masuk = debit Kas + kredit Pendapatan, Pembelian Tempo = debit Beban + kredit Utang Usaha. Isi volume dan satuan (pcs, kg, unit, porsi) bila ingin harga satuan ikut dihitung.</string>
    <string name="tour_entry_history_title">Riwayat dan Koreksi</string>
    <string name="tour_entry_history_desc">Setiap catatan bisa dibalik dengan jurnal pembalik: nilainya dinetralkan tetapi jejaknya tetap ada, sehingga laporan tetap bisa diaudit. Selain itu, tersedia opsi "Hapus" yang menghapus catatan secara permanen — gunakan jika catatan tersebut benar-benar salah masuk dan tidak perlu jejak koreksi.</string>
    <string name="tour_reports_tabs_title">Tiga Sudut Pandang</string>
    <string name="tour_reports_tabs_desc">Keuangan menjawab "berapa untungnya", Kelayakan menjawab "apakah usaha ini masuk akal dilanjutkan", dan Perbandingan menjawab "seberapa jauh realisasi meleset dari rencana".</string>
    <string name="tour_reports_profit_title">Laba Rugi dan Arus Kas</string>
    <string name="tour_reports_profit_desc">Laba Bersih = Pendapatan Operasional − Biaya Operasional. Angka ini memakai basis akrual: penjualan tempo sudah dihitung sebagai pendapatan walau uangnya belum diterima. Arus Kas Operasi hanya menghitung uang yang benar-benar bergerak, jadi wajar bila keduanya berbeda.</string>
    <string name="tour_reports_feasibility_title">BEP, HPP, dan B/C Ratio</string>
    <string name="tour_reports_feasibility_desc">BEP Rupiah: omzet minimum agar tidak rugi. BEP Volume: berapa jumlah volume penjualan/output minimum untuk menutup semua biaya. HPP per Satuan: biaya pokok setiap satuan produk/jasa — jual di bawah angka ini berarti rugi. B/C Ratio: penerimaan dibagi biaya; di atas 1 berarti usaha layak, di bawah 1 berarti biaya melebihi hasil. Isi Asumsi (jumlah volume dan harga jual) agar keempatnya terhitung. Keempat indikator ini yang membedakan pembukuan finansial dari catatan biasa — pemilik usaha bisa tahu apakah usahanya layak dilanjutkan, bukan sekadar untung atau rugi.</string>
