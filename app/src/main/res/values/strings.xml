    <!-- Tier 2 Contextual Page Tours -->
    <string name="tour_settings_drive_title">Sinkronisasi Cloud &amp; Google Drive</string>
    <string name="tour_settings_drive_desc">Hubungkan akun Google untuk mencadangkan pembukuan ke folder privat Google Drive (drive.appdata) secara aman. Tidak ada server pihak ketiga — cadangan ada sepenuhnya di Google Drive pribadi Anda, dalam folder tersembunyi yang hanya bisa diakses aplikasi ini.</string>
    <string name="tour_settings_security_title">Enkripsi AES-256-GCM &amp; Reset</string>
    <string name="tour_settings_security_desc">Semua cadangan dienkripsi dengan kata sandi Anda menggunakan AES-256-GCM. Tanpa kata sandi ini, cadangan tidak bisa dibuka — bahkan oleh pengembang aplikasi. Simpan kata sandi di tempat yang aman. Data lokal juga dapat diatur ulang sewaktu-waktu.</string>

    <string name="tour_scope_business_title">Tambah &amp; Kelola Usaha</string>
    <string name="tour_scope_business_desc">Buat unit usaha baru — misalnya \"Toko Sembako\", \"Warung Kopi\", atau \"Bengkel Motor\". Setiap unit usaha memiliki kategori akun, satuan barang, dan proyek/periode sendiri yang tidak saling bercampur.</string>
    <string name="tour_scope_field_title">Proyek &amp; Periode Pembukuan</string>
    <string name="tour_scope_field_desc">Tambahkan proyek, cabang, atau periode pembukuan spesifik serta tanggal awal dan akhirnya. Laporan kelayakan (BEP, HPP) dihitung per proyek atau periode pembukuan.</string>

    <string name="tour_import_picker_title">Pilih File Excel (.xlsx)</string>
    <string name="tour_import_picker_desc">Pilih workbook Excel catatan keuangan usaha Anda. Format kolom dan lembar kerja akan dianalisis dan dicocokkan secara cerdas. Kolom yang tidak dikenali dapat dipetakan manual sebelum impor final.</string>
    <string name="tour_import_target_title">Pemilihan Target Buku</string>
    <string name="tour_import_target_desc">Tentukan apakah data Excel dimasukkan ke Buku Proyeksi (Rencana) atau Buku Realisasi (Kas Nyata). Impor ke Proyeksi untuk memindahkan RAB yang sudah ada; impor ke Realisasi untuk memindahkan catatan kas nyata dari musim sebelumnya.</string>

    <string name="tour_reports_cashflow_title">Arus Kas Operasional</string>
    <string name="tour_reports_cashflow_desc">Arus kas menunjukkan uang yang benar-benar masuk dan keluar — bukan janji atau piutang. Kas Operasi mencatat aktivitas inti operasional usaha; Kas Investasi mencatat pembelian peralatan dan aset kerja; Kas Pendanaan mencatat modal sendiri dan pinjaman. Jika kas operasi negatif tetapi laba positif, artinya banyak penjualan yang belum dibayar.</string>
    <string name="tour_data_export_title">Ekspor &amp; Cadangan Data</string>
    <string name="tour_data_export_desc">Ekspor catatan ke file Excel (.xlsx) atau laporan PDF untuk arsip cetak. Cadangan lokal terenkripsi AES-256-GCM bisa disimpan ke penyimpanan ponsel, dan cadangan cloud ke Google Drive pribadi. Lakukan pencadangan rutin — terutama sebelum ganti ponsel atau akhir periode pembukuan.</string>
    <string name="tour_settings_display_title">Tampilan &amp; Bahasa</string>
    <string name="tour_settings_display_desc">Ganti tema Terang, Gelap, atau ikut Sistem. Pilih bahasa Indonesia atau Inggris. Atur kecepatan animasi: Penuh untuk transisi mulus, Dikurangi untuk perangkat lambat. Getar dan suara ketuk juga bisa dimatikan di sini.</string>
    <string name="about_desc">Mankeu adalah aplikasi manajemen keuangan dan pembukuan UMKM offline-first. Dirancang untuk membantu pemilik usaha, pengelola UMKM, dan wirausaha mencatat transaksi harian, menyusun rencana anggaran (RAB), menghitung titik impas (BEP), HPP per unit, kebutuhan modal kerja, dan rasio kelayakan usaha secara akurat tanpa tergantung koneksi internet.</string>
    <string name="about_version">Versi %s</string>

